# Copy to .env and fill in. .env is gitignored (contains no secrets beyond the
# Dex client secret, but keep it local anyway).

# Pin the Omni release (check ghcr.io/siderolabs/omni tags before bumping).
OMNI_VERSION=v1.9.3

# Hostnames — both are covered by the *.int.harville.dev wildcard cert.
OMNI_HOST=omni.int.harville.dev
DEX_HOST=omni-dex.int.harville.dev

# The LAN IP of THIS host — machines dial the SideroLink WireGuard tunnel here.
# Must be reachable from every node (10.1.10.0/24). The omni.int / omni-dex.int
# DNS records must resolve to this IP (see README "Where it runs").
OMNI_LAN_IP=10.1.10.88

# Shared secret between Omni and Dex's static "omni" client (see dex.yaml).
DEX_OMNI_CLIENT_SECRET=change-me-long-random

# First admin user (must match a Dex identity — the static break-glass admin,
# or an authelia user once the connector is live).
OMNI_ADMIN_EMAIL=admin@int.harville.dev

# EULA acceptance (self-hosted Omni requires these).
EULA_NAME=Isaiah Harville
EULA_EMAIL=harvillerisaiah@gmail.com
