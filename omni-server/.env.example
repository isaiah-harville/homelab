# Copy to the gitignored .env file (mode 600) on the Compose host. (The
# CoreOS host renders its secrets from coreos/secrets.sops.yaml instead.)
# Image versions are pinned in compose.yaml, not here.

OMNI_HOST=omni.int.harville.dev
DEX_HOST=omni-dex.int.harville.dev

# Must be reachable from every node and match both DNS records.
OMNI_LAN_IP=10.1.10.88

# Shared by Omni and Dex's static "omni" client: openssl rand -hex 32
DEX_OMNI_CLIENT_SECRET=change-me-long-random

# Break-glass admin (admin@int.harville.dev) password, as a bcrypt hash:
#   htpasswd -bnBC 10 "" '<password>' | tr -d ':\n'
# Keep the single quotes: the hash contains "$".
DEX_ADMIN_PASSWORD_HASH='$2y$10$REPLACE_WITH_BCRYPT_HASH'

# Must match a Dex identity.
OMNI_ADMIN_EMAIL=admin@int.harville.dev

EULA_NAME=Isaiah Harville
EULA_EMAIL=harvillerisaiah@gmail.com
