# Test VM settings for test/build.sh. A .test domain, so nothing can resolve
# to (or reach) the real Omni host. 10.0.2.2 is the QEMU user-network gateway:
# the Talos VM reaches the Omni VM's forwarded ports through the Mac.
HOSTNAME=omni-test
OMNI_DOMAIN=fcos.test
OMNI_HOST=omni.fcos.test
DEX_HOST=omni-dex.fcos.test
OMNI_LAN_IP=10.0.2.2
OMNI_ADMIN_EMAIL=admin@fcos.test
EULA_NAME=Homelab Test
EULA_EMAIL=test@fcos.test
ACME_EMAIL=test@fcos.test
ACME_SERVER=letsencrypt-staging
ALLOWED_CIDRS=10.0.2.0/24, 10.1.0.0/16
BACKUP_AGE_RECIPIENT=REPLACED_BY_BUILD_SH
BACKUP_KEEP_DAYS=56
VERSIONS_URL=http://10.0.2.2:8000/versions.yaml
PXE_ARCH=arm64
PXE_MENU_URL=http://10.0.2.2:8000/boot.ipxe
INSTALL_DEVICE=/dev/vda
ROOT_SIZE_MIB=10240
UPDATE_DAY=Sun
UPDATE_START=04:30
UPDATE_MINUTES=60
