# Dex for Omni's OIDC login, with a static break-glass admin. Independent of
# the cluster (and Authentik) on purpose.
[Unit]
Description=Dex (OIDC for Omni)
Requires=docker.service
After=docker.service network-online.target omni-cert-init.service
Wants=network-online.target omni-cert-init.service
RequiresMountsFor=/var/lib/omni

[Service]
EnvironmentFile=/etc/omni/images.env
ExecStartPre=-/usr/bin/docker rm --force dex
# Host networking keeps 5556 behind the host firewall's input chain; a
# published port would be DNATed past it. dex.env holds
# DEX_OMNI_CLIENT_SECRET and DEX_ADMIN_PASSWORD_HASH (secretEnv/hashFromEnv).
# Dex runs as uid/gid 1001; the key is root:1001 0640.
ExecStart=/usr/bin/docker run --rm --name dex --log-driver journald \
  --network host \
  --env-file /etc/omni/dex.env \
  -v /etc/omni/dex.yaml:/etc/dex/dex.yaml:ro \
  -v /var/lib/omni/certs:/etc/dex/tls:ro \
  ${DEX_IMAGE} dex serve /etc/dex/dex.yaml
ExecStop=/usr/bin/docker stop dex
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
