#!/usr/bin/env bash
# Everything that makes this Omni instance work and isn't in git: its
# databases, the GPG key that seals etcd, TLS and the secrets. Omni's etcd S3
# backups only cover cluster state, not this.
#
# The archive has the same layout as the Compose host's omni-backup.sh
# (data secrets certs .env .lego .lego-cf.env), so either host can restore
# the other's. Omni and Dex stop for the copy so etcd and SQLite are
# consistent. Encrypted to BACKUP_AGE_RECIPIENT; restore with omni-restore.
#
#   omni-backup [label]   label is appended to the file name (e.g. pre-upgrade)
set -euo pipefail
. /usr/local/lib/omni/omni-lib.sh

label=${1:+-$1}
out="$OMNI_STATE/backups"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
umask 077
install -d -m 0700 "$out"
install -d -m 0700 "$OMNI_STATE/.lego"
stage=$(mktemp -d /run/omni-backup.XXXXXX)

running=()
for unit in omni.service dex.service; do
  systemctl is-active --quiet "$unit" && running+=("$unit")
done
cleanup() {
  rm -rf "$stage"
  if ((${#running[@]})); then systemctl start "${running[@]}"; fi
}
trap cleanup EXIT

# .env and .lego-cf.env as the Compose host had them, built from /etc/omni.
load_env "$OMNI_ETC/dex.env"
cat > "$stage/.env" <<ENV
OMNI_HOST=$OMNI_HOST
DEX_HOST=$DEX_HOST
OMNI_LAN_IP=$OMNI_LAN_IP
DEX_OMNI_CLIENT_SECRET=$DEX_OMNI_CLIENT_SECRET
DEX_ADMIN_PASSWORD_HASH='$DEX_ADMIN_PASSWORD_HASH'
OMNI_ADMIN_EMAIL=$OMNI_ADMIN_EMAIL
EULA_NAME=$EULA_NAME
EULA_EMAIL=$EULA_EMAIL
ENV
cp "$OMNI_ETC/lego.env" "$stage/.lego-cf.env"

if ((${#running[@]})); then systemctl stop omni.service dex.service; fi
file="$out/omni-$stamp$label.tar.gz.age"
tar -czf - -C "$OMNI_STATE" data secrets certs .lego -C "$stage" .env .lego-cf.env |
  docker run --rm -i --network=none omni-tools:local \
    age -r "$BACKUP_AGE_RECIPIENT" > "$file.tmp"
mv "$file.tmp" "$file"
log "wrote $file"
find "$out" -name 'omni-*.tar.gz.age' -mtime +"$BACKUP_KEEP_DAYS" -delete
