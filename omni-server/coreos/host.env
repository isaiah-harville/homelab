# Non-secret settings for the Omni host, read by render.sh at build time and
# installed as /etc/omni/host.env for the host's own scripts. Secrets live in
# secrets.sops.yaml; image versions in versions.yaml.
#
# Plain KEY=value lines only: render.sh and systemd both read this file, and
# neither runs a shell over it.

HOSTNAME=omni
OMNI_DOMAIN=int.harville.dev
OMNI_HOST=omni.int.harville.dev
DEX_HOST=omni-dex.int.harville.dev
# The address machines reach WireGuard on (--siderolink-wireguard-advertised-addr).
# Keep the current host's address so joined machines need no change.
OMNI_LAN_IP=10.1.10.88
OMNI_ADMIN_EMAIL=admin@int.harville.dev
EULA_NAME=Isaiah Harville
EULA_EMAIL=harvillerisaiah@gmail.com
ACME_EMAIL=harvillerisaiah@gmail.com
# lego's --server; a URL or a shortcode such as letsencrypt-staging.
ACME_SERVER=letsencrypt

# Who may reach SSH and Omni's ports: the home network, which covers the
# nodes (10.1.10.0/24) and the workstation VLAN (10.1.1.0/24). nftables set
# syntax: comma-separated prefixes.
ALLOWED_CIDRS=10.1.0.0/16

# Host-state backups are encrypted to the repo's SOPS age recipient
# (.sops.yaml), whose identity is kept off-host for disaster recovery.
BACKUP_AGE_RECIPIENT=age10ukgkhw204tv9u00mf57jfmxwkfhrp0f6k3vjak3caztelhgh5us9a5jj4
BACKUP_KEEP_DAYS=56

# Where omni-sync reads the pinned images from.
VERSIONS_URL=https://raw.githubusercontent.com/isaiah-harville/homelab/main/omni-server/coreos/versions.yaml

# Network boot. UniFi's DHCP points machines at this host (Network Boot =
# OMNI_LAN_IP, filename ipxe.efi); pxe-tftp serves the iPXE build for this
# UEFI arch (x86_64 or arm64), whose embedded script chains boot.ipxe.
# pxe-menu builds the menu on the host from Omni's presets (never in git):
# Talos with PXE_EXTENSIONS, and a GPU entry adding PXE_GPU_EXTENSIONS.
# Mirror base_extensions and gpu_extensions in terraform/omni/locals.tf.
PXE_ARCH=x86_64
PXE_EXTENSIONS=siderolabs/iscsi-tools siderolabs/util-linux-tools
PXE_GPU_EXTENSIONS=siderolabs/nonfree-kmod-nvidia-production siderolabs/nvidia-container-toolkit-production

# Install target and layout. The root filesystem (OS, /var, container images)
# gets ROOT_SIZE_MIB; the rest of the disk is the omni-data partition, which a
# reinstall keeps. The host (Dell Latitude 5521) has one disk, a 512 GB SK
# hynix NVMe; with a single NVMe the kernel name is stable, while its
# /dev/disk/by-id names differ between udev versions.
INSTALL_DEVICE=/dev/nvme0n1
ROOT_SIZE_MIB=32768

# Zincati reboots into OS updates only in this window (UTC), after the Sunday
# 02:45 backup and the 03:30 certificate check.
UPDATE_DAY=Sun
UPDATE_START=04:30
UPDATE_MINUTES=60
