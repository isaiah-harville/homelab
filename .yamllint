---
extends: default

ignore: |
  clusters/**/secrets/**
  clusters/**/sops/**
  *.sops.yaml
  # Vendored upstream release manifests; kept byte-identical for upgrades.
  infrastructure/cnpg-system/cnpg-barman-plugin/app/plugin-barman-cloud.yaml
  infrastructure/rabbitmq-system/rabbitmq-operator/app/cluster-operator.yaml

rules:
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 2
