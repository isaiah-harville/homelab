---
extends: default

ignore: |
  clusters/**/secrets/**
  clusters/**/sops/**
  clusters/**/flux-system/gotk-*.yaml
  clusters/**/flux-system/gotk-*.yml
  # Vendored upstream release manifest; kept byte-identical for upgrades.
  infrastructure/base/cnpg-barman-plugin/plugin-barman-cloud.yaml

rules:
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 2
