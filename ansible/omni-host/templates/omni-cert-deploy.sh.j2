#!/usr/bin/env bash
# Managed by ansible/omni-host. lego's deploy hook: stage the new cert where
# compose.yaml mounts it and restart Omni and Dex to load it.
set -euo pipefail
dir={{ omni_dir }}
src="$dir/.lego/certificates/_.{{ omni_domain }}"
install -m 0644 "$src.crt" "$dir/certs/server-chain.pem"
# Readable by Dex through compose.yaml's group_add, not by everyone.
install -m 0640 "$src.key" "$dir/certs/server-key.pem"
cd "$dir" && docker compose restart
